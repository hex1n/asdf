#!/bin/sh
# Distribution rides the commit boundary: a commit is the point where a
# change has passed the evidence loop, so sync the installed copies now.
# Never block or fail the commit — install problems degrade to a one-line
# pointer and `install.mjs --dry-run` remains the drift backstop.
command -v node >/dev/null 2>&1 || exit 0
repo="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -f "$repo/bootstrap/install.mjs" ] || exit 0
node "$repo/bootstrap/install.mjs" >/dev/null 2>&1 || \
  echo "asdf post-commit: install.mjs failed; run manually: node bootstrap/install.mjs" >&2
exit 0
